# Copy to .env for running on this PC. On GitHub, add each as a repository secret instead.
# Leave a line out and that platform is skipped (its posts are saved to data/outbox).

# Facebook Page + Instagram business account (same token; free via Meta for Developers)
HOINOW_FB_PAGE_ID=
HOINOW_FB_TOKEN=
HOINOW_IG_USER_ID=
FINEHOMELOAN_FB_PAGE_ID=
FINEHOMELOAN_FB_TOKEN=
FINEHOMELOAN_IG_USER_ID=

# LinkedIn (author is urn:li:organization:12345 for a company page, or urn:li:person:abc for you)
HOINOW_LINKEDIN_TOKEN=
HOINOW_LINKEDIN_AUTHOR=
FINEHOMELOAN_LINKEDIN_TOKEN=
FINEHOMELOAN_LINKEDIN_AUTHOR=

# Google Business Profile (one Google Cloud OAuth app for both)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HOINOW_GBP_REFRESH_TOKEN=
HOINOW_GBP_ACCOUNT_ID=
HOINOW_GBP_LOCATION_ID=
FINEHOMELOAN_GBP_REFRESH_TOKEN=
FINEHOMELOAN_GBP_ACCOUNT_ID=
FINEHOMELOAN_GBP_LOCATION_ID=

# Pinterest
HOINOW_PINTEREST_TOKEN=
HOINOW_PINTEREST_BOARD_ID=
FINEHOMELOAN_PINTEREST_TOKEN=
FINEHOMELOAN_PINTEREST_BOARD_ID=

# Threads
HOINOW_THREADS_USER_ID=
HOINOW_THREADS_TOKEN=
FINEHOMELOAN_THREADS_USER_ID=
FINEHOMELOAN_THREADS_TOKEN=

# Bluesky (Settings > App passwords in Bluesky)
HOINOW_BLUESKY_HANDLE=
HOINOW_BLUESKY_APP_PASSWORD=
FINEHOMELOAN_BLUESKY_HANDLE=
FINEHOMELOAN_BLUESKY_APP_PASSWORD=

# Optional: free Google Gemini key (aistudio.google.com) for friendlier AI-written captions; set ai = "gemini" in config.toml
GEMINI_API_KEY=
